# Scanner sizing / cadence
TOP_N_SYMBOLS=100
SCAN_CONCURRENCY=25
SIGNAL_HISTORY_BARS=60
SIGNAL_Z_MIN_SAMPLES=24
CVD_LOOKBACK_BARS=8
VPIN_WINDOW_BASKETS=10
BETA_MIN_SAMPLES=24
ATR_LOOKBACK_BARS=12

# Liquidity / signal gates
MIN_24H_VOLUME_USDT=10000000
MAX_SPREAD_BPS=2.5
MIN_EFFECTIVE_RRR=1.30
FRICTION_RT_PCT=0.0018
MAX_STRONG_PER_DIRECTION=3
MAX_PORTFOLIO_CORRELATION=0.80
MAX_AGGREGATE_RISK_PCT=0.03
FUNDING_PROXIMITY_MINUTES=20
FUNDING_EXTREME_THRESHOLD_8H=0.0010
OBI_DECAY=0.85

# Risk levels
ACCOUNT_EQUITY_USDT=10000
RISK_PER_TRADE_PCT=0.01
MAX_LEVERAGE=3
MAX_DRAWDOWN_PCT=0.20
DAILY_LOSS_LIMIT_PCT=0.08
ATR_STOP_MULTIPLIER=1.50
MAX_ATR_MULTIPLIER=2.50
SWEEP_BOOSTER_POINTS=0.0

# Execution-cost approximation; replace with empirical fill data later
TAKER_COMMISSION_RT_PCT=0.0010
SLIPPAGE_ATR_FRACTION=0.15
MAX_SLIPPAGE_RT_PCT=0.0030

# Infrastructure safety
CB_MAX_FAILURES=5
CB_HALT_MINUTES=30
BINANCE_REQUEST_WEIGHT_BUDGET=2280
BINANCE_MAX_REQUEST_RETRIES=3
BINANCE_RETRY_BACKOFF_CAP_SEC=8
BINANCE_429_BACKOFF_SEC=1
BINANCE_418_COOLDOWN_SEC=60
PAPER_TRADING=1
# For live alerting/execution, provide CURRENT_EQUITY_USDT or data/equity_state.json.
# Create data/KILL_SWITCH to block new risk immediately.

# Select exactly one independent screener route: quant_5m or level_retest_12h.
SCREENER_MODE=quant_5m

# Former 12h swing-high resistance -> breakout -> support retest detector (research/alerts only)
LEVEL_RETEST_HISTORY_BARS=100
LEVEL_RETEST_MIN_TOUCHES=2
LEVEL_RETEST_CLUSTER_TOLERANCE_PCT=0.012
LEVEL_RETEST_BASE_ZONE_PCT=0.005
LEVEL_RETEST_ATR_ZONE_MULTIPLIER=0.30
LEVEL_RETEST_MAX_ZONE_PCT=0.015
LEVEL_RETEST_MIN_BREAKOUT_PCT=0.004
LEVEL_RETEST_MIN_BOUNCE_PCT=0.003
LEVEL_RETEST_MAX_EXTENSION_PCT=0.025
LEVEL_RETEST_MIN_SCORE=55

# Research feature recorder
RESEARCH_DB=data/research/features.sqlite3

# Required with CURRENT_EQUITY_USDT in live mode; Unix epoch milliseconds from the reconciler.
CURRENT_EQUITY_UPDATED_MS=

# Standalone 12h former-high support-retest mode: 0 = all eligible USDT-M futures
LEVEL_RETEST_TOP_N_SYMBOLS=0
LEVEL_RETEST_MIN_24H_VOLUME_USDT=0
